DATABASE_URL=your_db_url_here
SESSION_SECRET=your_session_secret_here

# Admin auth — protects all API routes except /api/healthz
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MISSION_CONTROL_ADMIN_TOKEN=your_admin_token_here

# Encryption key for credentials stored in the agent tool vault
# Must be exactly 32 bytes. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MISSION_CONTROL_ENCRYPTION_KEY=your_32_byte_base64_key_here

# NODE_ENV is set automatically (development | production)
# PORT is assigned automatically per artifact by the platform
# BASE_PATH is assigned automatically per artifact by the platform
